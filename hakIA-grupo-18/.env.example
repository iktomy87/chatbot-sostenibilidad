# Puerto del servidor Express
PORT=3000

# Supabase (opcional). Si no se configuran, la app usa almacenamiento en memoria automáticamente.
SUPABASE_URL=
SUPABASE_KEY=

# Groq (obligatorio para chat, function calling y visión)
GROQ_API_KEY=
# Modelo de texto/function calling. Ver modelos vigentes en https://console.groq.com/docs/models
# (si este falla con "model_decommissioned", revisar https://console.groq.com/docs/deprecations)
GROQ_MODEL=openai/gpt-oss-120b
# Modelo con soporte de visión para leer facturas escaneadas como imagen.
# Actualmente el único modelo multimodal soportado por Groq es qwen/qwen3.6-27b (modelo "preview",
# no recomendado por Groq para producción, pero es la única opción de visión disponible hoy).
GROQ_VISION_MODEL=qwen/qwen3.6-27b
